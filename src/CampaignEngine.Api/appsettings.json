{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=campaigns.db",
    "AutoCreate": true
  },
  "Catalog": {
    "CacheSeconds": 30
  },
  "Engine": {
    "Decimals": 2,
    "Selection": "BestForCustomer"
  }
}
